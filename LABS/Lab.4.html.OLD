        Roman,Times,serif;">&gt;</span></small><font size="-1"> use
      loggingService</font><font size="-1"><span style="color: rgb(0, 0,
        153);"><br>
      </span></font><small><span style="font-family: Times New
        Roman,Times,serif;">&gt;</span></small><font size="-1"> show
      collections</font><font size="-1"><span style="color: rgb(0, 0,
        153);"><br>
      </span></font><small><span style="font-family: Times New
        Roman,Times,serif;">&gt;</span></small><font size="-1">
      db.logging.find().pretty()<br>
    </font><small><span style="font-family: Times New
        Roman,Times,serif;">&gt;</span></small><font size="-1"> quit()</font><br>
    <font size="-1"><br>
      And you should see the log for the new user you created in
